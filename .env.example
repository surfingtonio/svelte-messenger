# Server
PORT=4000

# JWT — generate a strong secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-before-deploying

# CORS — comma-separated list of allowed frontend origins
# For local dev this covers Vite's default port
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:4000

# Database (optional — defaults to ./messenger.db for local SQLite)
# For Azure Database for PostgreSQL, set this to your connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname
