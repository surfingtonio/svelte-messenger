# Server
PORT=4000

# JWT — generate a strong secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-before-deploying

# CORS — comma-separated list of allowed frontend origins
# For local dev this covers Vite's default port
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:4000

# Database path for SQLite (local dev default: ./messenger.db)
# For Azure, point this to a mounted persistent volume path, e.g.:
#   DATABASE_URL=/home/persist/messenger.db
# To use Azure Database for PostgreSQL, swap the Drizzle driver in src/db/index.ts
# and set DATABASE_URL to your PostgreSQL connection string instead.
DATABASE_URL=./messenger.db
